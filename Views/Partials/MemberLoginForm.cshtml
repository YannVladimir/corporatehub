@model CorporateHub.Models.LoginMemberViewModel

@using (Html.BeginUmbracoForm("HandleLogin", "MemberLoginSurface"))
{
	@Html.ValidationSummary(true)

	<label>Email</label>
	<input asp-for="Email" />
	<span asp-validation-for="Email"></span>

	<label>Password</label>
	<input asp-for="Password" type="password" />
	<span asp-validation-for="Password"></span>

	<label><input asp-for="RememberMe" /> Remember me</label>

	<button type="submit">Login</button>
}
