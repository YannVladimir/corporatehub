@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Security;
@inject IMemberManager MemberManager
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<title>@(Model.Value<string>("browserTitle"))</title>
	<meta name="description" content="@(Model.Value<string>("metaDescription"))" />
	<meta property="og:title" content="@(Model.Value<string>("browserTitle"))" />
	@{
		var ogImage = Model.Value<IPublishedContent>("openGraphImage");
	}
	@if (ogImage is not null)
	{
		<meta property="og:image" content="@ogImage.Url()" />
	}
</head>
<body>
	<header>
		<partial name="Partials/Navigation" model="Model" />
		<nav class="language-switcher">
			@{
				var homeNode = Model.Root();
			}
			@foreach (var culture in homeNode.Cultures)
			{
				<a href="@homeNode.Url(culture: culture.Key)">@culture.Value.Name</a>
			}
		</nav>
		@if (MemberManager.IsLoggedIn())
		{
			var currentMember = await MemberManager.GetCurrentMemberAsync();
			<nav class="member-status">
				<span>Welcome, @currentMember?.Name</span>
				@using (Html.BeginUmbracoForm("HandleLogout", "MemberLoginSurface"))
				{
					<button type="submit">Logout</button>
				}
			</nav>
		}
	</header>

	<main>
		@RenderBody()
	</main>

	<footer>
		@await Html.PartialAsync("Partials/NewsletterSignupForm", new CorporateHub.Models.NewsletterSignupViewModel())
	</footer>

	<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
