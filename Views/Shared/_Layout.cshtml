@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<title>@(Model.Value<string>("browserTitle"))</title>
</head>
<body>
	<header>
		<partial name="Partials/Navigation" model="Model" />
		<nav class="language-switcher">
			@{
				var homeNode = Model.Root();
			}
			@foreach (var culture in homeNode.Cultures)
			{
				<a href="@homeNode.Url(culture: culture.Key)">@culture.Value.Name</a>
			}
		</nav>
	</header>

	<main>
		@RenderBody()
	</main>

	<footer></footer>
</body>
</html>
