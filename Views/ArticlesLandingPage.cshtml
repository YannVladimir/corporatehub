@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.ArticlesLandingPage>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
	const int pageSize = 1; // small on purpose, so paging is visible with just 2 test articles

	var categories = Umbraco.ContentAtRoot().OfType<ContentModels.Category>().ToList();
	var selectedCategoryId = Context.Request.Query["category"].ToString();

	var articles = Model.Children<ContentModels.Article>();
	if (int.TryParse(selectedCategoryId, out var categoryId))
	{
		articles = articles.Where(a => a.Categories.Any(c => c.Id == categoryId));
	}

	var articlesList = articles.ToList();
	var totalPages = (int)Math.Ceiling(articlesList.Count / (double)pageSize);

	int.TryParse(Context.Request.Query["page"].ToString(), out var currentPage);
	if (currentPage < 1) { currentPage = 1; }
	if (totalPages > 0 && currentPage > totalPages) { currentPage = totalPages; }

	var pagedArticles = articlesList.Skip((currentPage - 1) * pageSize).Take(pageSize);

	string PageUrl(int page)
	{
		var categoryQuery = string.IsNullOrEmpty(selectedCategoryId) ? "" : $"&category={selectedCategoryId}";
		return $"{Model.Url()}?page={page}{categoryQuery}";
	}
}

<h1>@Model.Heading</h1>
<p>@Model.IntroText</p>

<nav>
	<a href="@Model.Url()">All</a>
	@foreach (var category in categories)
	{
		<a href="@Model.Url()?category=@category.Id">@category.Name</a>
	}
</nav>

<ul>
	@foreach (var article in pagedArticles)
	{
		<partial name="Partials/ArticleTeaser" model="article" />
	}
</ul>

<div>
	@if (currentPage > 1)
	{
		<a href="@PageUrl(currentPage - 1)">Previous</a>
	}
	<span>Page @currentPage of @totalPages</span>
	@if (currentPage < totalPages)
	{
		<a href="@PageUrl(currentPage + 1)">Next</a>
	}
</div>